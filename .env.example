# SatQuery AI Environment Configuration Example
# NLP / LLM Reasoning Model
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-14b:free
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=3

# Multimodal Vision Models
VISION_PROVIDER=qwen_openrouter
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=qwen25
VISION_VQA_MODEL=qwen25
VISION_CAPTION_MODEL=qwen25
VISION_GROUND_MODEL=qwen3
VISION_TIMEOUT=45.0
VISION_MAX_RETRIES=2

# API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GeoChat Microservice Configuration
GEOCHAT_BASE_URL=http://172.25.166.59:8000
GEOCHAT_API_KEY=your_geochat_api_key_here
