# SatQuery AI Environment Configuration Example
# NLP / LLM Reasoning Model
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.tokenrouter.com/v1
LLM_MODEL=z-ai/glm-5.3-free
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=2

# Multimodal Vision Models
VISION_PROVIDER=openrouter
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=qwen25
VISION_VQA_MODEL=qwen25
VISION_CAPTION_MODEL=qwen25
VISION_GROUND_MODEL=qwen3
VISION_TIMEOUT=120.0
VISION_MAX_RETRIES=2

# API Keys
TOKENROUTER_API_KEY=your_tokenrouter_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GeoChat Microservice Configuration
GEOCHAT_BASE_URL=http://100.108.110.84:8000/
GEOCHAT_API_KEY=your_geochat_api_key_here

